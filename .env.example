APP_ENV=production
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-chars
TRUST_PROXY_HEADERS=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ALLOW_SQLITE_IN_PRODUCTION=false
